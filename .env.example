# EpixBox environment-variable reference.
# Copy server-side values to server/.env and client-side VITE_* values to
# client/.env.local. Keep real credentials out of Git.

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
API_BASE_URL=http://localhost:4000/api/v1

# Use DATABASE_URL OR the DB_* settings below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=photoapp_dev
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

JWT_ACCESS_SECRET=replace-with-a-unique-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret

# Google OAuth (server accepts one or more client IDs)
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# AWS S3: server-side only. Use a dedicated, restricted IAM identity.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=

# SMTP email
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# Payments (configure only providers enabled for your deployment)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Server policy and operational settings
ADMIN_EMAILS=
OWNER_EMAILS=
OWNER_EMAIL=
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_UPLOAD_MAX=60
RATE_ANALYTICS_WINDOW_SIZE=1000
LOG_LEVEL=info
PUBLIC_CACHE_MAX_AGE=300
PUBLIC_CACHE_S_MAX_AGE=1800
IMAGE_JPEG_QUALITY=82
WATERMARK_ENABLED=false
WATERMARK_TEXT=EpixBox
ENABLE_UPLOAD_EMAIL_NOTIFICATIONS=false
AUTO_MIGRATE=false
ALLOW_PENDING_MIGRATIONS=false
EXTERNAL_CHECKOUT_URL_TEMPLATE=

# Leave debug/test routes disabled outside a controlled local environment.
DEBUG_EMAIL_API_KEY=
DEBUG_LOGIN_EMAIL=
ENABLE_DEBUG_LOGIN=false
ENABLE_RAZORPAY_TEST=false
ENABLE_SENTRY_TEST_ROUTE=false

# Optional API monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Vite client (public build-time configuration only)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME=EpixBox
VITE_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Experimental Google Pay UI settings; the API payment endpoint is not implemented.
VITE_GOOGLE_PAY_MERCHANT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PAYPAL_CLIENT_ID=
VITE_CLOUDFRONT_DOMAIN=
VITE_OWNER_EMAILS=

# Optional client monitoring
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_LOGROCKET_APP_ID=

# Optional local load-test settings
LOAD_TEST_BASE_URL=http://localhost:4000
LOAD_TEST_CONNECTIONS=30
LOAD_TEST_DURATION=15
TARGET_URL=http://localhost:4000/api/v1/checkout/razorpay/webhook
